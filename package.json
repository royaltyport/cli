{
  "name": "@royaltyport/cli",
  "version": "2.0.0",
  "description": "Royaltyport CLI — authenticate, list projects, and connect to project file systems",
  "type": "module",
  "bin": {
    "royaltyport": "bin/royaltyport.js"
  },
  "scripts": {
    "start": "node bin/royaltyport.js",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "lint": "eslint",
    "link:cli": "sh scripts/link.sh",
    "unlink:cli": "sh scripts/unlink.sh",
    "publish:cli": "npm publish --access public",
    "publish:beta": "npm publish --access public --tag beta",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "royaltyport",
    "cli"
  ],
  "license": "UNLICENSED",
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "5.4.1",
    "commander": "13.1.0",
    "conf": "13.1.0",
    "ora": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royaltyport/cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
